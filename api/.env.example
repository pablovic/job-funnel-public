# Copy this file to api/.env (that file is git-ignored and never committed).
#
# With docker compose, the database host is "db" (the name of the service in
# docker-compose.yml), not "localhost". For a hosted Postgres such as Neon, paste
# its connection string here instead, starting with postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://funnel:funnel@db:5432/funnel

# ---------------------------------------------------------------- scoring mode
# free      = regex extraction + keyword scoring. No key, no cost, no rate limit.
#             This is the default and it works. Start here.
# gemini    = Google's free tier. Set GEMINI_API_KEY.
# ollama    = a model running locally on your own machine. Set OLLAMA_MODEL.
# anthropic = paid, about 2 cents per posting. Set ANTHROPIC_API_KEY.
LLM_PROVIDER=free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=

# Hard filters. These are decisions, not defaults — change them here, never in a prompt.
COMP_FLOOR_USD_YEAR=85000
REQUIRE_REMOTE=true
LANGUAGES=en,es,pt
# Where you can work from: global, latam, or add a country code you're eligible for.
ELIGIBLE_REGIONS=global,latam

# Optional: render the funnel into an Obsidian vault (absolute path, then folder).
OBSIDIAN_VAULT=
OBSIDIAN_FOLDER=Job Search

# Only applies to the paid provider. Irrelevant when LLM_PROVIDER=free.
DAILY_LLM_BUDGET_USD=2.0
